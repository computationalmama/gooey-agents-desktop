{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gooey Agents",
  "version": "0.1.2",
  "identifier": "ai.gooey.agents",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gooey Agents",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCQUZDOUU4MDVFOUIwNDAKUldSQXNPa0Y2TW12cTFOZVNaRkJucUdjMlc5QWdMUGNyU0ZDcTR0TGhrbFFFYndQSDBwT3RyelIK",
      "endpoints": [
        "https://github.com/computationalmama/gooey-agents-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
